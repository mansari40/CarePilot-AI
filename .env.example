# ── Database (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_USER=agentcare
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=agentcare
# Connection used by the backend (db = compose service name; use localhost for local dev)
DATABASE_URL=postgresql+psycopg://agentcare:change-me-dev-only@db:5432/agentcare

# ── LLM (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Per-call hard timeout (seconds).  Prevents a hung Groq connection from
# blocking a workflow indefinitely.  45 s is generous; the typical call
# finishes in 2-5 s.
GROQ_TIMEOUT=45
# Overall wall-clock cap for the entire multi-agent pipeline (seconds).
# Even if individual calls don't time out, the whole run is abandoned if
# it exceeds this limit.  Must be > GROQ_TIMEOUT * expected_max_calls.
WORKFLOW_TIMEOUT=120

# ── Auth / JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=http://localhost:3000

# ── Tests ──────────────────────────────────────────────────────────────
# Set to 1 to run the small number of live-Groq integration tests (requires GROQ_API_KEY)
RUN_LIVE_LLM_TESTS=0